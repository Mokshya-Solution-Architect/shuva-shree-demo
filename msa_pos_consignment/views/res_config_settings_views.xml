<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ss_consignment" model="ir.ui.view">
        <field name="name">res.config.settings.form.ss.consignment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="inside">
                <setting string="Consignment Dispatch"
                         help="Allow cashiers to dispatch products to distributor-suppliers and settle payment after they report actual sales."
                         id="ss_pos_consignment_dispatch">
                    <field name="pos_enable_consignment"/>
                    <div class="content-group mt16" invisible="not pos_enable_consignment">
                        <div class="row">
                            <label for="pos_consignment_location_id" string="Transit Location" class="col-lg-3 o_light_label"/>
                            <field name="pos_consignment_location_id" class="col-lg-9"/>
                        </div>
                        <div class="row">
                            <label for="pos_consignment_return_location_id" string="Returns Staging" class="col-lg-3 o_light_label"/>
                            <field name="pos_consignment_return_location_id" class="col-lg-9"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
