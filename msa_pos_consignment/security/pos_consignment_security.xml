<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_consignment_company_rule" model="ir.rule">
        <field name="name">POS Consignment: multi-company</field>
        <field name="model_id" ref="model_pos_consignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="pos_consignment_line_company_rule" model="ir.rule">
        <field name="name">POS Consignment Line: multi-company</field>
        <field name="model_id" ref="model_pos_consignment_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
